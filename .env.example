# Copy to .env.local and fill in. .env* is gitignored; this file is not.

# ---------------------------------------------------------------- Contributions
# Classic or fine-grained PAT with `read:user` and `repo` scope. Without it the
# projects calendar falls back to scraped public data with no private split.
GITHUB_TOKEN=

# ----------------------------------------------------------------- Contact form
# https://resend.com/api-keys
RESEND_API_KEY=

# The domain verified at https://resend.com/domains. The sender becomes
# "Portfolio <contact@THIS_DOMAIN>".
RESEND_FROM_DOMAIN=

# Optional. Overrides the derived sender entirely when a different mailbox or
# display name is wanted, e.g. "Allan Jeo Joseph <hello@allanjeo.dev>".
RESEND_FROM_EMAIL=

# ---------------------------------------------------------------- Abuse control
# Optional. Without these the contact form still rate limits, but the counters
# live in each serverless instance rather than being shared, so the real
# ceiling is the configured limit times the number of warm instances.
# Provision Upstash Redis from the Vercel Marketplace and paste both values.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Signs the hidden form token. Defaults to a value derived from
# RESEND_API_KEY; set this if rotating that key should not invalidate every
# contact form currently open in a browser.
CONTACT_FORM_SECRET=

# ------------------------------------------------------------------------ Site
# Canonical origin used for metadata, sitemap and OG URLs.
NEXT_PUBLIC_SITE_URL=
